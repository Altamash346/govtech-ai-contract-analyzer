# Copy this file to .env and fill in your values

# --- Ollama (Local AI Engine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- Embeddings & Vector Store ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./vector_store

# --- Database ---
DATABASE_URL=sqlite:///./app.db
APP_SECRET_KEY=change-me-in-production

# --- AI Mode ---
# "secure" = local Ollama (slow, private, no internet needed)
# "fast"   = Gemini API (fast, data sent to Google cloud)
AI_MODE=secure

# --- Gemini API (only needed if AI_MODE=fast) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Subscription Plans & Quotas (Configurable) ---
FREE_MONTHLY_UPLOADS=5
PERSONAL_MONTHLY_UPLOADS=30
BUSINESS_MONTHLY_UPLOADS=100
PERSONAL_MONTHLY_PRICE=49
PERSONAL_ANNUAL_PRICE=499
BUSINESS_MONTHLY_PRICE=149
BUSINESS_ANNUAL_PRICE=1499

FREE_AI_QUERY_LIMIT=15
PERSONAL_AI_QUERY_LIMIT=60
BUSINESS_AI_QUERY_LIMIT=250

# --- Payment Gateway (Razorpay Sandbox / Test Keys) ---
# Register free at https://dashboard.razorpay.com to get your test credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder
